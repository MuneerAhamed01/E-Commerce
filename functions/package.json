{
  "name": "trends-functions",
  "description": "Cloud Functions for Trends e-commerce",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "seed": "npm run build && node lib/scripts/seed-catalog.js",
    "seed:validate": "npm run build && node lib/scripts/validate-seed-data.js",
    "lint": "eslint --ext .js,.ts ."
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "private": true
}
